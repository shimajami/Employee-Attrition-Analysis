  <worksheets>
    <worksheet name='Attrition Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='WA_Fn-UseC_-HR-Employee-Attrition' name='federated.0g551hj075dkfn15gg4gi1hilzly' />
          </datasources>
          <datasource-dependencies datasource='federated.0g551hj075dkfn15gg4gi1hilzly'>
            <column datatype='string' name='[Attrition]' role='dimension' type='nominal' />
            <column caption='Attrition Rate' datatype='real' default-format='p0.00%' name='[Calculation_0442867951288320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Attrition] = &quot;Yes&quot; THEN 1 ELSE 0 END)&#13;&#10;/&#13;&#10;COUNT([EmployeeNumber])' />
            </column>
            <column caption='Tenure Group' datatype='string' name='[Calculation_0442868145700865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [YearsAtCompany] &lt;= 2 THEN &quot;0-2 Years&quot;&#13;&#10;ELSEIF [YearsAtCompany] &lt;= 5 THEN &quot;3-5 Years&quot;&#13;&#10;ELSEIF [YearsAtCompany] &lt;= 10 THEN &quot;6-10 Years&quot;&#13;&#10;ELSE &quot;11+ Years&quot;&#13;&#10;END' />
            </column>
            <column caption='Risk Segment' datatype='string' name='[Calculation_0442868153176067]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[OverTime]&#13;&#10;+ &quot; | &quot;&#13;&#10;+ [Calculation_0442868145700865]&#13;&#10;+ &quot; | Satisfaction &quot;&#13;&#10;+ STR([JobSatisfaction])' />
            </column>
            <column datatype='string' name='[Department]' role='dimension' type='nominal' />
            <column caption='Employee Number' datatype='integer' name='[EmployeeNumber]' role='dimension' type='ordinal' />
            <column caption='Job Role' datatype='string' name='[JobRole]' role='dimension' type='nominal' />
            <column caption='Job Satisfaction' datatype='integer' name='[JobSatisfaction]' role='measure' type='quantitative'>
              <aliases>
                <alias key='1' value='Low' />
                <alias key='2' value='Medium' />
                <alias key='3' value='High' />
                <alias key='4' value='Very High' />
              </aliases>
            </column>
            <column caption='Over Time' datatype='string' name='[OverTime]' role='dimension' type='nominal' />
            <column caption='Years At Company' datatype='integer' name='[YearsAtCompany]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0442867951288320]' derivation='User' name='[usr:Calculation_0442867951288320:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0g551hj075dkfn15gg4gi1hilzly].[Action (Department)]'>
            <groupfilter function='level-members' level='[Department]' user:ui-action-filter='[Action1_5C458EF173C4445A96058E71C6C04B5B]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
